# --- Obligatoire ---
ANTHROPIC_API_KEY=
TWILIO_AUTH_TOKEN=
# URL publique HTTPS du serveur, sans slash final (ex. https://dms-phone.example.fr)
PUBLIC_URL=
# Chaîne aléatoire longue (openssl rand -hex 32) pour signer l'accès au WebSocket
SIGNING_SECRET=

# --- Modèle (latence faible recommandée pour la voix) ---
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- Voix Twilio ConversationRelay (à vérifier dans la doc Twilio) ---
LANGUAGE=fr-FR
TTS_PROVIDER=Google
TTS_VOICE=
STT_PROVIDER=Google

# --- Notifications (sans donnée de santé) ---
SLACK_WEBHOOK_URL=

# --- Agenda Google (facultatif : sans lui, les demandes de RDV deviennent des messages) ---
GOOGLE_CALENDAR_ID=
# Chemin du fichier JSON du compte de service, agenda partagé avec ce compte
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- Réglages ---
TIMEZONE=Europe/Paris
# JSON : jour (1=lundi … 7=dimanche) -> [heure ouverture, heure fermeture]
BUSINESS_HOURS={"1":[9,17],"2":[9,17],"3":[9,17],"4":[9,17],"5":[9,17]}
APPOINTMENT_MINUTES=60
MIN_NOTICE_HOURS=24
RETENTION_DAYS=30
DATA_DIR=./data
PORT=8080
